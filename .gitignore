# Python caches and local environments
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
htmlcov/
.venv/
venv/
build/
dist/

# Generated experiment artifacts
outputs/
logs/
*.log
*.tmp
*.bak

# Local-only research traceability payloads; the tracked index is in research_archive/.
research_archive/artifacts/
research_archive/private/

# Large data/run directories that may appear on a workstation or server
data/
datasets/
!configs/datasets/
!configs/datasets/*.yaml
runs/
checkpoints/
weights/
cache/
caches/
wandb/
mlruns/
lightning_logs/

# External or copied scientific inputs are never committed by default
inputs/
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
*.pkl
*.pickle
*.onnx
*.h5
*.hdf5
*.joblib
*.parquet
*.arrow
*.feather
*.zarr/

# Machine-specific configuration and credentials
configs/*.local.yaml
configs/*.local.yml
configs/*.private.yaml
configs/*.private.yml
configs/*.secret.yaml
configs/*.secret.yml
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
.ssh/
id_rsa*
id_ed25519*

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
