    "test_parent_list": ["top_potsdam_2_13", "top_potsdam_2_14", "top_potsdam_3_13", "top_potsdam_3_14", "top_potsdam_4_13", "top_potsdam_4_14", "top_potsdam_4_15", "top_potsdam_5_13", "top_potsdam_5_14", "top_potsdam_5_15", "top_potsdam_6_13", "top_potsdam_6_14", "top_potsdam_6_15", "top_potsdam_7_13"],
    "test_patches": 3584,
    "patch_source": "Postdam_patches_512_full (512x512 patches, 256 per parent tile)",
    "note": "first-paper candidates cover train/val only; test tiles have no prior candidates (truly held-out proposals)"
  },
  "model": {
    "identity": "OpenAI CLIP ViT-B/32 quick-GELU; OpenCLIP/timm converted state_dict",
    "architecture": "ViT-B-32-quickgelu",
    "open_clip_version": "3.3.0",
    "feature_dimension": 512,
    "checkpoint_sha256": "9ecdaef325b20e7283dc6a32f92aa638d100899e4f084c2462d3832eeea0b26e",
    "load_policy": "weights_only=True, strict=True, eval mode"
  },
  "prompts": {
    "group_a_templates": ["{class}", "a photo of {class}", "an aerial image of {class}", "a satellite image of {class}", "a remote sensing image of {class}", "{class} in an aerial image", "{class} in a satellite image", "a region of {class} viewed from above"],
    "count": 8
  },
  "classes": ["impervious_surface", "building", "low_vegetation", "tree", "car"],
  "gt_encoding": {
    "label_dir": "Postdam_patches_512_full/5_Labels_all",
    "color_map": {
      "impervious_surface": [255, 255, 255],
      "building": [0, 0, 255],
      "low_vegetation": [0, 255, 255],
      "tree": [0, 255, 0],
      "car": [255, 255, 0]
    },
    "clutter_color": [255, 0, 0],
    "clutter_rule": "clutter pixels (red) are ignore; never vote"
  },
  "alpha": 0.5,
  "visual_prototype_construction": {
    "source": "SAM3 weak labels from test-tile proposals (all-positive image-level assumption via frozen image_level_labels.csv); prototypes built from train-area-equivalent rules",
    "steps": ["L2 normalize each region feature", "arithmetic mean per class", "L2 normalize the class prototype"]
  },
  "scc_formula": {
    "text_score": "T_c(x) = cosine(x, t_c)",
    "anchored_score": "A_c(x) = cosine(x, p_c), p_c = Normalize(0.5*t_c + 0.5*v_c)",
    "support_shift": "b(x) = mean_{c in S}[ A_c(x) - T_c(x) ]",
    "supported_final": "S_c(x) = A_c(x) - b(x)",
    "unsupported_final": "S_c(x) = T_c(x)"
  },
  "ctp_decision_rule": {
    "text_top1": "t* = argmax_c T_c(x)",
    "text_confidence": "m_t(x) = T_{t*}(x) - T_second(x)",
    "preserve": "t* unsupported AND T_{t*}(x) + m_t(x) > max_{c in Supported} S_c^SCC(x) -> predict t*",
    "else": "argmax_c S_c^SCC(x)",
    "k0": "Text-only", "kC": "SCC == C2",
    "no_threshold": true, "no_temperature": true, "no_beta": true, "no_training": true
  },
  "segmentation": {
    "candidate_masks": "SAM3 proposals generated by the frozen first-paper pipeline (same config family as potsdam_server_prompt4.json, same checkpoint, tile 512/overlap 128, score_threshold 0.55, min_area 32, max_area_ratio 0.95)",
    "fusion_canvas": "FusionCanvas (per-pixel highest region score wins)",
    "overlap_resolution": "highest score per pixel; ties by class id order",
    "conflict_threshold": 0.03,
    "uncovered_handling": "uncovered = 255 (ignore)",
    "background": "no background class; uncovered = ignore",
    "ignore_index": 255
  },
  "gt_isolation": {
    "order": ["predictions computed", "prediction/config/support hashes persisted", "then GT read", "then evaluation"],
    "predict_phase_forbidden": ["semantic GT", "pixel labels", "evaluation masks", "GT-derived statistics", "GT-based rule tuning"]
  },
  "evaluation": {
    "level": "pixel",
    "full_support_metrics": ["OA", "macro_f1", "mIoU", "per_class_iou", "per_class_f1", "precision", "recall", "pixel_stats"],
    "partial_support": {"ratios": [0.25, 0.5, 0.75], "seeds": [42, 43, 44], "pre_registered": true},
    "partial_metrics": ["OA", "macro_f1", "mIoU", "S_F1", "U_F1", "H_F1", "S_IoU", "U_IoU", "H_IoU"],
    "bootstrap": {"seed": 42, "repeats": 5000, "cluster": "image_id (patch)", "deltas": ["OA", "macro_f1", "mIoU", "H_F1", "H_IoU"], "comparisons": ["CTP vs Text-only", "CTP vs C2", "CTP vs SCC"]}
  },
  "constraints": {
    "training": false, "adapter": false, "learned_gating": false, "new_proposal_network": false,
    "alpha_tuning": false, "prompt_tuning": false, "threshold_tuning": false, "margin_tuning": false,
    "temperature": false, "beta": false, "gt_before_predictions": false, "gt_based_rule_tuning": false,
    "remoteclip": false, "dino": false, "multi_prototype": false, "overwrite": false
  }
}
