  "scientific_evidence": true,
  "dataset": "ISPRS Potsdam 2D Semantic Labeling",
  "dataset_role": "external held-out dataset evaluation",
  "untouched_audit": "reports/potsdam_untouched_audit.md (all three checks negative; 14 test tiles never used by second-paper method development)",
  "split": {
    "parent_split": "potsdam_parent_split_23_0_14_paper.json",
